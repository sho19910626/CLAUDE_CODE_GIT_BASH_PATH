# Anthropic API キー (https://platform.claude.com/ で取得) — 必須
# アバター設計・台本・運用設計の生成に使用します
ANTHROPIC_API_KEY=sk-ant-...

# 生成に使うモデル (任意・省略時は claude-opus-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# 入口のパスワード — クラウドに公開するときは必須
# 設定するとブラウザがユーザー名とパスワードを聞くようになります。
# 未設定だと誰でもアクセスでき、APIを勝手に使われて課金されます。
# ローカルで自分だけで使う場合は未設定のままで構いません。
# BASIC_AUTH_USER=team
# BASIC_AUTH_PASSWORD=

# OpenAI API キー (https://platform.openai.com/ で取得) — 任意
# 設定すると「アバターの見た目案」を画像で確認できるようになります
# OPENAI_API_KEY=sk-...

# 画像生成モデル (任意・省略時は gpt-image-2)
# OPENAI_IMAGE_MODEL=gpt-image-1
