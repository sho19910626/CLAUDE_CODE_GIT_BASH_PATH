{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // include が **/*.ts のため、フォルダの中に別プロジェクトを置くと
  // そちらのファイルまで型チェックされ、無関係なエラーでビルドが止まる。
  // (既存のフォルダの中に git clone してしまったときに起こる)
  "exclude": [
    "node_modules",
    "CLAUDE_CODE_GIT_BASH_PATH",
    "**/node_modules",
    "_backup",
    "_stray-backup"
  ]
}
