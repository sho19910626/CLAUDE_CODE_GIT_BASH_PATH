# ------------------------------------------------------------
# 入口のパスワード(必須)
#
# セッション Cookie の署名の鍵と、最初の管理者を作るときの合言葉を兼ねます。
# 本番(NODE_ENV=production)で未設定だと、誰もログインできません。
#
# この値を変えると、その瞬間に全員のログインが切れます(強制ログアウトの手段)。
# 32文字以上のランダムな文字列にしてください。
#   例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ------------------------------------------------------------
APP_PASSWORD=

# ------------------------------------------------------------
# データベース接続文字列(必須。ローカル開発でも必要)
#
# 顧客企業名・商談・売上はすべてここに入ります。
# 「顧客データを個々のパソコンに置かない」という決まりのため、
# このツールにはファイル保存の代替手段を用意していません。
# 未設定だと起動しません(素通しにはなりません)。
#
# Neon(https://neon.tech)の無料枠で十分です。
#   例: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# テーブル名の接頭辞は crm_ です。同じ Neon データベースを他のツールと
# 使い回しても、テーブルはぶつかりません。
# ------------------------------------------------------------
DATABASE_URL=
