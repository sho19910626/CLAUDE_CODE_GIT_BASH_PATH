# Anthropic API キー (https://platform.claude.com/ で取得) — 必須
# コンテンツ企画・コピーライティングの生成に使用します
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API キー (https://platform.openai.com/ で取得) — 任意
# 設定すると「AI写真」背景(画像生成)が使えるようになります
OPENAI_API_KEY=sk-...

# 画像生成モデル (任意・省略時は gpt-image-1)
# OpenAIから新しい画像モデルが出たらここを変更するだけで切り替えられます
# OPENAI_IMAGE_MODEL=gpt-image-1
