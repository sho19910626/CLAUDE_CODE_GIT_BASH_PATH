# Anthropic API キー (https://platform.claude.com/ で取得) — 必須
# 求人提案・掲載原稿・考察文の生成に使用します
ANTHROPIC_API_KEY=sk-ant-...

# Indeed 提案スタジオで使うモデル (任意・省略時は claude-opus-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# 入口のパスワードは下の APP_PASSWORD に一本化しました。
# (以前の BASIC_AUTH_USER / BASIC_AUTH_PASSWORD は使いません)

# OpenAI API キー (https://platform.openai.com/ で取得) — 任意
# 設定すると提案スタジオの「メインカット」AI画像生成が使えるようになります
OPENAI_API_KEY=sk-...

# 画像生成モデル (任意・省略時は gpt-image-2 = 2026年4月の最新モデル)
# gpt-image-2 が使えないアカウントでは gpt-image-1 を指定してください
# OpenAIから新しい画像モデルが出たらここを変更するだけで切り替えられます
# OPENAI_IMAGE_MODEL=gpt-image-1

# ===== チームで共有する場合 =====

# ログインパスワード(公開時は必須)
# サイト全体(営業コンソール・提案スタジオ・求人診断)の入口の鍵です。
# 全員がこの1つのパスワードでログインします。退職・異動があったら変更してください。
# 本番で未設定だと誰もログインできません(ローカル開発では未設定でも動きます)
APP_PASSWORD=

# データベース接続文字列(共有時は必須)
# 未設定だと .data/store.json に保存され、そのPCの中だけで完結します
# Neon (https://neon.tech) の無料枠が手軽です
DATABASE_URL=
