# Anthropic API キー (https://platform.claude.com/ で取得) — 必須
# コンテンツ企画・コピーライティング・求人提案の生成に使用します
ANTHROPIC_API_KEY=sk-ant-...

# Indeed 提案スタジオで使うモデル (任意・省略時は claude-opus-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# 入口のパスワード — クラウドに公開するときは必須
# 設定するとブラウザがユーザー名とパスワードを聞くようになります。
# 未設定だと誰でもアクセスでき、APIを勝手に使われて課金されます。
# ローカルで自分だけで使う場合は未設定のままで構いません。
# BASIC_AUTH_USER=team
# BASIC_AUTH_PASSWORD=

# OpenAI API キー (https://platform.openai.com/ で取得) — 任意
# 設定すると「AI写真」背景(画像生成)が使えるようになります
OPENAI_API_KEY=sk-...

# 画像生成モデル (任意・省略時は gpt-image-2 = 2026年4月の最新モデル)
# gpt-image-2 が使えないアカウントでは gpt-image-1 を指定してください
# OpenAIから新しい画像モデルが出たらここを変更するだけで切り替えられます
# OPENAI_IMAGE_MODEL=gpt-image-1

# 動画生成モデル (任意・省略時は sora-2)
# より高品質にしたい場合は sora-2-pro (料金は約3倍)
# OPENAI_VIDEO_MODEL=sora-2

# ───────────────────────────────────────────────
# 動画編集スタジオ (/video) の設定
# ───────────────────────────────────────────────

# 文字起こしとAIナレーションには OPENAI_API_KEY (上記) を使います。
# 未設定でも編集画面は使えますが、文字起こしとAIナレーションが使えません。

# 文字起こしモデル (任意・省略時は whisper-1)
# タイムスタンプ付きの書き起こしが必要なため、これに対応したモデルを指定してください
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# ナレーションの音声合成モデルと既定の声 (任意)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# テロップのフォント (任意)
# 省略時は OS 標準の日本語ゴシック(Windows:游ゴシック/メイリオ、macOS:ヒラギノ、
# Linux:Noto Sans CJK)を自動で探します。ブランドフォントを使う場合だけ指定してください。
# TELOP_FONT_PATH=C:/Windows/Fonts/YuGothM.ttc
# TELOP_FONT_BOLD_PATH=C:/Windows/Fonts/YuGothB.ttc

# ffmpeg / ffprobe の場所 (任意)
# npm install で自動的に同梱されるため、通常は設定不要です。
# 同梱バイナリが動かない環境でだけ、実行ファイルのパスを指定してください。
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# BGMライブラリの置き場所 (任意・省略時は public/bgm)
# ここに置いた音源が、書き出し設定のBGM一覧に出ます。
# 置き方とSuno用のプロンプトは public/bgm/README.md にまとめてあります。
# BGM_DIR=D:/video-studio-bgm

# 素材と書き出し結果の置き場所 (任意・省略時はプロジェクト直下の .work)
# 動画は1案件で数GBになるため、空きの多いドライブを指定できます。
# VIDEO_WORK_DIR=D:/video-studio-work
