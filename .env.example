# Anthropic API キー (https://platform.claude.com/ で取得) — 必須
# 採用アカウント設計・求人提案の生成に使用します
ANTHROPIC_API_KEY=sk-ant-...

# Indeed 提案スタジオで使うモデル (任意・省略時は claude-opus-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# ------------------------------------------------------------
# 入口のパスワード
#
# みんなで共有する場合(start-shared.bat)や、インターネットに
# 公開する場合は必ず設定してください。
# 設定すると、お名前とパスワードを入れるログイン画面が出るようになります。
# 本番で未設定だと誰もログインできません(ローカル開発では未設定でも動きます)。
#
# 自分のパソコンで自分だけが使う場合は、未設定のままで構いません。
#
# ※ insta-studio と avatar-studio は別アプリなので、この設定は効きません。
#    そちらは各フォルダの .env に別途書いてください(別のパスワードにできます)。
# ------------------------------------------------------------
APP_PASSWORD=

# OpenAI API キー (https://platform.openai.com/ で取得) — 任意
# 設定すると「AI写真」背景(画像生成)が使えるようになります
OPENAI_API_KEY=sk-...

# 画像生成モデル (任意・省略時は gpt-image-2 = 2026年4月の最新モデル)
# gpt-image-2 が使えないアカウントでは gpt-image-1 を指定してください
# OpenAIから新しい画像モデルが出たらここを変更するだけで切り替えられます
# OPENAI_IMAGE_MODEL=gpt-image-1

# 動画生成モデル (任意・省略時は sora-2)
# より高品質にしたい場合は sora-2-pro (料金は約3倍)
# OPENAI_VIDEO_MODEL=sora-2

# ------------------------------------------------------------
# データベース接続文字列(必須)
#
# アカウントと、顧客に関わるデータ(ブランドキットなど)の置き場です。
# 顧客情報は個々のパソコンに置かない決まりのため、
# 本番(NODE_ENV=production)では未設定だと起動しません。
# ローカル開発のときだけ .data/accounts.json に落ちます。
#
# ツールごとにテーブル名の接頭辞が違うので、同じ Neon データベースを
# 使い回しても、ツールごとに使える人を分けられます。
# ------------------------------------------------------------
DATABASE_URL=
