# ============================================================
# note 収益化スタジオ の設定
#
# 【このファイルは見本です。中身は空のまま git に入っています】
#
# 使うときは、このファイルを .env という名前でコピーして、値を入れてください。
#
#   cp .env.example .env          (Windows なら copy .env.example .env)
#
# .env のほうは .gitignore で除外してあるので git に入りません。
# API キーとパスワードが入るファイルなので、GitHub には上げないでください。
# ============================================================

# Anthropic API キー (https://platform.claude.com/ で取得) — 必須
# 競合リサーチの分析・ジャンル選定・記事の執筆に使います
#
# = の右側に、sk-ant- で始まる文字列をそのまま貼ってください。
# 引用符で囲まない / = の前後に空白を入れない。
ANTHROPIC_API_KEY=

# 使うモデル (任意・省略時は claude-opus-5)
# 記事の質が売上に直結するので、既定のまま opus を推奨します。
# 費用を抑えたいときだけ claude-sonnet-5 に変えてください。
# ANTHROPIC_MODEL=claude-sonnet-5

# ------------------------------------------------------------
# 入口のパスワード(必須)
#
# セッション Cookie の署名の鍵です。
# 本番(NODE_ENV=production)で未設定だと、誰もログインできません。
# ローカル開発のときだけ、未設定でも素通しで動きます。
#
# この値を変えると、その瞬間に全員のログインが切れます(強制ログアウト)。
# 他のツール(insta-studio / avatar-studio)とは別の値にできます。
#
# = の右側に、自分で決めた 20 文字以上の文字列を貼ってください。
# ------------------------------------------------------------
APP_PASSWORD=

# ------------------------------------------------------------
# データベース接続文字列(必須)
#
# アカウントと、運用データ(リサーチ結果・戦略・記事・売上実績)の置き場です。
# 顧客情報は個々のパソコンに置かない決まりのため、
# 本番(NODE_ENV=production)では未設定だと動きません。
# ローカル開発のときだけ .data/accounts.json に落ちます。
#
# テーブル名の接頭辞は note_ です。他のツールと同じ Neon データベースを
# 使い回しても、テーブルもアカウントも混ざりません。
#
# = の右側に、postgresql:// で始まる接続文字列をそのまま貼ってください。
# ------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------
# note の公開データ取得(任意)
#
# 競合リサーチは note の公開ページが返す JSON を読んで集計します。
# ログインは不要で、誰でも見られる情報しか取りません。
#
# NOTE_FETCH_DELAY_MS  1回の取得ごとに空ける間隔(ミリ秒・既定 700)
#                      短くすると相手のサーバーに負担をかけます。触らないでください。
# NOTE_FETCH_MAX       1回のリサーチで取りに行く上限回数(既定 40)
# ------------------------------------------------------------
# NOTE_FETCH_DELAY_MS=700
# NOTE_FETCH_MAX=40
