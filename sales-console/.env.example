# ============================================================
# 商談ナビ（DFA Robotics 活動報告ジェネレーター）の設定
#
# このファイルをコピーして .env という名前で保存し、値を入れてください。
# Vercel に公開するときは、同じ3つを Environment Variables に入れます。
# ============================================================

# Anthropic API キー（必須）
# https://platform.claude.com/ で取得。報告書の生成と、STEP1 の企業リサーチに使います。
ANTHROPIC_API_KEY=sk-ant-...

# 使うモデル（任意・省略時は claude-opus-5）
# ANTHROPIC_MODEL=claude-sonnet-5

# ------------------------------------------------------------
# ログインの署名の鍵（必須）
#
# ここを変えると、その瞬間に全員のログインが切れます（強制ログアウトの手段）。
# 本番（NODE_ENV=production）で未設定だと、誰もログインできません。
# 最初の管理者アカウントを作るときの「初期設定の合言葉」も、この値です。
# 12文字以上、他のツールと使い回さないでください。
# ------------------------------------------------------------
APP_PASSWORD=

# ------------------------------------------------------------
# データベース接続文字列（必須）
#
# アカウントと、案件・議事録・報告本文の置き場です。
# 顧客情報を個々のパソコンに置かない決まりのため、
# 本番では未設定だと動きません（ローカル開発のときだけ .data/ に落ちます）。
#
# 既存の Neon をそのまま使えます。このツールのテーブルは sales_ で始まるので、
# 他のツール（insta_ / avatar_ など）とは混ざりません。
# アカウントもテーブルが別なので、営業メンバーの分をこのツールで新規発行します。
# ------------------------------------------------------------
DATABASE_URL=
